# ====================
# Configuración de Base de Datos PostgreSQL
# ====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=orderdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ====================
# Configuración de Kafka
# ====================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=order-processor-group

# ====================
# Configuración de AWS / LocalStack
# ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SQS_ENDPOINT=http://localstack:4566
SQS_QUEUE_NAME=ordenes-procesadas-queue
SQS_DLQ_NAME=ordenes-procesadas-dlq

# ====================
# Configuración de Seguridad JWT
# ====================
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-characters-long
JWT_ISSUER=ms-event-processor
JWT_EXPIRATION=86400000

# ====================
# Configuración de Spring AI - OpenAI
# ====================
# IMPORTANTE: Para habilitar el chat con IA, necesitas una API key de OpenAI
# 1. Ve a https://platform.openai.com/api-keys
# 2. Crea una cuenta o inicia sesión
# 3. Genera una nueva API key
# 4. Copia la key y pégala aquí (debe empezar con "sk-")
OPENAI_API_KEY=your-openai-api-key-here

# ====================
# Configuración de Retry
# ====================
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_INTERVAL=1000
RETRY_MULTIPLIER=2.0
RETRY_MAX_INTERVAL=10000
